rules_version = '2';

// See COPILOT_BUILD_GUIDE.md Section 2 for the schema and rule rationale this file implements.
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {
      // Anonymous participants may create their own session document exactly once, at consent time.
      // No PII fields exist on this schema, so there is nothing further to validate about identity.
      allow create: if request.resource.data.consentGiven == true
                    && request.resource.data.status == 'in_progress'
                    && request.resource.data.completedAt == null
                    && !('groundTruth' in request.resource.data);

      // Incremental writes during play (choices, freeTexts, minigames, currentScene, status,
      // postGameInterview, wellbeingSummary). `groundTruth` may only be written in the same update
      // that marks the session completed, or after it has already been completed — never before.
      // An authenticated user may also write their `userId` to link the session to their account
      // (Google sign-in gate after the game — see COPILOT_BUILD_GUIDE.md Phase 3).
      allow update: if (
                      !('groundTruth' in request.resource.data)
                      || request.resource.data.completedAt != null
                      || resource.data.completedAt != null
                    )
                    && (
                      // Allow unauthenticated incremental writes (during gameplay)
                      !request.auth != null
                      // OR an authenticated user linking their UID to the session
                      || (request.auth != null
                          && request.resource.data.userId == request.auth.uid)
                    );

      // Authenticated users may read only their own sessions — used for the
      // "already completed this assessment" duplicate check at sign-in time.
      // A `where("userId", "==", uid)` query ensures all returned documents
      // satisfy this condition, so `list` is covered as well as `get`.
      allow read: if request.auth != null
                   && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Only Cloud Functions (Admin SDK, which bypasses rules) may touch the LLM usage counters.
    match /usage/{date} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
